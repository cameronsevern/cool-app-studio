{
  "name": "cool-app-studio",
  "version": "0.1.0",
  "private": false,
  "description": "A local-first editor and deterministic renderer for app-store screenshots.",
  "keywords": [
    "app-store",
    "cli",
    "device-mockup",
    "google-play",
    "local-first",
    "screenshot"
  ],
  "homepage": "https://github.com/cameronsevern/mockup-studio#readme",
  "bugs": {
    "url": "https://github.com/cameronsevern/mockup-studio/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cameronsevern/mockup-studio.git"
  },
  "author": "Cameron Severn",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "examples/",
    "src/"
  ],
  "bin": {
    "cool-app-studio": "src/cli.mjs"
  },
  "scripts": {
    "start": "node src/cli.mjs serve --open",
    "serve": "node src/cli.mjs serve",
    "render": "node src/cli.mjs render",
    "test": "node test/renderer-contract.mjs && node test/config.mjs && node test/zip.mjs && node test/server.mjs && node test/span.mjs && node test/smoke.mjs",
    "test:renderer-contract": "node test/renderer-contract.mjs",
    "test:config": "node test/config.mjs",
    "test:server": "node test/server.mjs",
    "test:smoke": "node test/smoke.mjs",
    "check:package": "npm pack --dry-run",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "playwright": "1.61.1"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
